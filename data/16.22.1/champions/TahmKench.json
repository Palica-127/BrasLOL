 "passiva_texto": {
  "nome": "Um Gosto Adquirido",
  "descricao": "Tahm Kench usa o próprio corpo para impulsionar os Ataques, causando dano adicional com base na Vida total dele. Causar dano a Campeões inimigos aumenta os acúmulos de <spellName>Um Gosto Adquirido</spellName>. Com três acúmulos, ele pode usar <spellName>Devorar</spellName> em um Campeão inimigo."
 },
 "habilidades_texto": [
  {
   "slot": "Q",
   "id": "TahmKenchQ",
   "nome": "Língua-chicote",
   "descricao": "Tahm Kench ataca com a língua, causando dano e Lentidão à primeira unidade atingida, além de se curar se a unidade for um Campeão inimigo.<br><br>Aplica um acúmulo de <spellName>Um Gosto Adquirido</spellName> a Campeões inimigos. Se o Campeão já tiver 3 acúmulos de <spellName>Um Gosto Adquirido</spellName>, ele será Atordoado e os acúmulos serão consumidos.",
   "tooltip": "Causa <magicDamage>{{ totaldamage }} de Dano Mágico</magicDamage> e {{ slowamount*100 }}% de <status>Lentidão</status> ao primeiro inimigo atingido por {{ slowduration }}s. <br /><br />Ao acertar um Campeão, cura Tahm Kench em <healing>{{ baseheal }} + {{ percenthealthhealing*100 }}% da própria Vida perdida</healing> e aplica um acúmulo de <spellName>Um Gosto Adquirido</spellName>, causando <magicDamage>{{ spell.tahmkenchpassive:totaldamage }} de Dano Mágico adicional</magicDamage>. Se o Campeão já tiver 3 acúmulos de <spellName>Um Gosto Adquirido</spellName>, ele será <status>Atordoado</status> por {{ stunduration }}s e os acúmulos serão consumidos.<br /><br />Ative <span class=\"color0bf7de\">Devorar</span> enquanto a língua estiver no meio do trajeto para devorar Campeões inimigos que já tiverem 3 acúmulos de <spellName>Um Gosto Adquirido</spellName> ao atingi-los.{{ spellmodifierdescriptionappend }}",
   "recarga": [
