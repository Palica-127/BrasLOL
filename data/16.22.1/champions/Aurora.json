 "habilidades_texto": [
  {
   "slot": "Q",
   "id": "AuroraQ",
   "nome": "Feitiço Dúplice",
   "descricao": "Aurora envia um projétil que amaldiçoa qualquer inimigo que atingir. Ela pode reconjurar a Habilidade para puxar de volta as maldições ativas na direção dela, causando dano a inimigos atingidos no caminho.",
   "tooltip": "Dispara energia amaldiçoada em uma direção, causando <magicDamage>{{ damage }} de Dano Mágico</magicDamage> aos inimigos e amaldiçoando-os por {{ markduration }}s.<br /><br /><recast>Reconjurar:</recast> Encerra a maldição, puxando parte do espírito do inimigo para Aurora e causando até <magicDamage>{{ q2damagemax }} de Dano Mágico</magicDamage> aos inimigos atravessados com base na Vida perdida deles. O dano causado após o primeiro golpe é reduzido para 20%.<br /><br />Se a duração terminar, Aurora <recast>Reconjurará</recast> a Habilidade automaticamente.{{ spellmodifierdescriptionappend }}",
   "recarga": [
