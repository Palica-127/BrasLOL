 "habilidades_texto": [
  {
   "slot": "Q",
   "id": "IreliaQ",
   "nome": "Surto da Lâmina",
   "descricao": "Irelia avança para atingir o seu alvo e cura a si mesma. Se ele estiver marcado ou for abatido com Surto da Lâmina, o Tempo de Recarga será restaurado.",
   "tooltip": "Irelia avança até um inimigo, causando <physicalDamage>{{ championdamage }} de Dano Físico</physicalDamage> e restaurando <healing>{{ healamount }} de Vida</healing>. Se o inimigo morrer ou estiver <keywordMajor>Instável</keywordMajor>, o Tempo de Recarga é redefinido.<br /><br />Causa {{ miniondamage }} de dano a tropas.{{ spellmodifierdescriptionappend }}",
