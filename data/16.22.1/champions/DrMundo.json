 "passiva_texto": {
  "nome": "Vai Para Onde Quer",
  "descricao": "Dr. Mundo resiste ao próximo efeito Imobilizador que o atingir, perdendo Vida e derrubando um recipiente químico nas proximidades. Dr. Mundo pode pegar o recipiente ao passar por cima dele, restaurando Vida e reduzindo o Tempo de Recarga da Habilidade.<br><br>Dr. Mundo também tem Regeneração de Vida significativamente mais alta.<br>"
 },
 "habilidades_texto": [
  {
   "slot": "Q",
   "id": "DrMundoQ",
   "nome": "Serra Infectada",
   "descricao": "Dr. Mundo arremessa uma serra infectada, causando dano ao primeiro inimigo atingido com base na Vida atual do alvo e causando Lentidão a ele.",
   "tooltip": "Dr. Mundo arremessa sua serra, causando <magicDamage>{{ currenthealthdamage*100 }}% da Vida atual como Dano Mágico</magicDamage> e {{ slowamount*100 }}% de <status>Lentidão</status> por {{ slowduration }}s ao primeiro inimigo que atingir.<br /><br />Se a serra atingir um Campeão ou monstro, Dr. Mundo restaurará <healing>{{ healthrestoreonhitchampionmonster }} de Vida</healing>. Se atingir um não Campeão ou não monstro, Dr. Mundo restaurará <healing>{{ healthrestoreonhitminion }} de Vida</healing>.{{ spellmodifierdescriptionappend }}",
